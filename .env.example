# Copy to .env for local runs (main.py doesn't load .env itself -- use
# `export $(cat .env | xargs)` or a tool like python-dotenv / honcho if you
# want that), or set these directly as Render environment variables.
#
# Neither key is required to start the server. Without one set, /api/analyze
# and /api/reschedule still work end-to-end using only the free rule-based
# extractor -- ambiguous messages come back escalate_to_human=True instead
# of a guess, same as the offline pipeline with no key configured.

# Free-tier Gemini key, tried first if set (see model/gemini_llm.py).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Used only as a fallback if GEMINI_API_KEY is unset (see
# model/hybrid_extraction.py's default_llm_call()).
ANTHROPIC_API_KEY=
