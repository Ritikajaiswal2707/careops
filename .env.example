# Optional local demo configuration. main.py does not load this file itself.
# Export these variables in your shell, or install python-dotenv and load .env
# in your own local launcher. Render environment variables are configured in
# the Render dashboard. Do not commit a real .env file or API key.
#
# The demo works without either key. In rules-only mode, ambiguous messages
# are escalated to a human; no external API call is made.

# Google Gemini API key. The default model is gemini-3.8-flash and can be
# overridden with GEMINI_MODEL. Used only on live API requests routed to LLM.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional fallback if Gemini has no key or returns no usable result.
# Requires `pip install anthropic` and a valid key.
ANTHROPIC_API_KEY=
